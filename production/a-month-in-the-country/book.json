  "episodes": [
    {
      "title": "The New Tutor",
      "from_part": "I",
      "to_part": "I",
      "thumb_art": "1_cards",
      "blurb": "A summer afternoon on the Islayev estate. Natalya Petrovna is bored with her devoted friend Rakitin, the cards go round, and a young student, Belyaev, arrives as tutor to her son. The doctor Shpigelsky has a proposal for the ward Vera."
    },
    {
      "title": "Raspberries and a Kite",
      "from_part": "II",
      "to_part": "II",
      "thumb_art": "2_kite",
      "blurb": "In the garden Vera and Belyaev make a kite, the maid Katya is courted by two men, and the shy neighbour Bolshintsov is coached by the doctor in how to propose. Natalya Petrovna watches the young people and cannot hide her new feelings from Rakitin."
    },
    {
      "title": "Natalya Petrovna's Secret",
      "from_part": "III",
      "to_part": "III",
      "thumb_art": "3_confidence",
      "blurb": "Natalya Petrovna tries to marry her ward off, draws out Vera's secret and discovers her own. Rakitin names what is happening to her, and she summons Belyaev to dismiss him."
    },
    {
      "title": "The Declaration",
      "from_part": "IV",
      "to_part": "IV",
      "thumb_art": "4_hall",
      "blurb": "In an empty hall in the evening light the doctor proposes to the companion Lizaveta Bogdanovna, Vera confronts her guardian, and Natalya Petrovna and Belyaev say what they must not say."
    },
    {
      "title": "The Parting",
      "from_part": "V",
      "to_part": "V",
      "thumb_art": "5_parting",
      "blurb": "The morning after. Islayev asks his oldest friend the question he fears, Rakitin leaves, Belyaev leaves, Vera decides her future, and the household is left with what was said."
    }
  ],
  "glossary": [
    [
      "Natalya Petrovna",
      "Russians are addressed by first name and patronymic: Natalya, daughter of Pyotr; Arkady Sergeich is Arkady, son of Sergei. Close friends and family use short forms: Natasha, Arkasha, Verochka, Mishel (Michel)."
    ],
    [
      "preference",
      "a Russian card game for three or four, played at the card table in Act One."
    ],
    [
      "whist",
      "a card game for four players, a favourite pastime of country houses."
    ],
    [
      "souls",
      "serfs; an estate was counted by its number of “souls” (male serfs), so “three hundred souls” means a wealthy landowner."
    ],
    [
      "verst",
      "a Russian measure of distance, a little over a kilometre."
    ],
    [
      "ward",
      "a girl brought up in a household as its dependent; Vera is an orphan raised by Natalya's family."
    ],
    [
      "name-day",
      "the feast day of a person's saint, celebrated like a birthday; Natalya Petrovna's is a week away."
    ],
    [
      "troika",
      "a carriage drawn by three horses; the doctor's reward for matchmaking."
    ],
    [
      "tutor",
      "a young man hired to teach the family's son, here for the summer months."
    ],
    [
      "Monte Cristo",
      "the novel by Alexandre Dumas that Rakitin reads aloud in the opening scene."
    ],
    [
      "Talleyrand",
      "the famously crafty French diplomat; Natalya Petrovna mocks the doctor as a “district Talleyrand”."
    ]
  ],
