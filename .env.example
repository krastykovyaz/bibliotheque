# Grandlivre connection. Create these with: node scripts/grandlivre-register.mjs
GRANDLIVRE_CLIENT_ID=
GRANDLIVRE_REDIRECT_URI=http://localhost:4321/grandlivre/callback
# 32 random bytes, base64. Encrypts stored tokens. If you lose it, users must reconnect.
GRANDLIVRE_TOKEN_KEY=
# Optional. Default: .data/bibliotheque.sqlite
# DATABASE_PATH=
