---
import Layout from '../layouts/Layout.astro';
import { ui, pageUrl } from '../lib/i18n';
const t = ui.en;
---

<Layout lang="en" path="/" title={`${t.notFound} | ${t.site}`} description={t.notFoundText}>
  <div class="prose">
    <h1>{t.notFound}</h1>
    <p>{t.notFoundText}</p>
    <p><a href={pageUrl('en', '/')}>{t.backHome}</a></p>
  </div>
</Layout>
