---
// Settings: the Grandlivre connection state for this browser's session. Rendered on the server.
import Layout from '../layouts/Layout.astro';
import { ui, pageUrl, type UiLang } from '../lib/i18n';
import { getDeps, readSid } from '../server/context.ts';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = ui[lang];
const deps = getDeps();
const sid = deps && readSid(Astro.cookies, deps);
const status = deps && sid ? deps.store.status(sid) : 'none';

const messages: Record<string, string> = {
  connected: t.glMsgConnected,
  denied: t.glMsgDenied,
  state: t.glMsgState,
  error: t.glMsgError,
  disconnected: t.glMsgDisconnected,
  unconfigured: t.glUnconfigured,
};
const message = messages[Astro.url.searchParams.get('grandlivre') ?? ''];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout lang={lang} path="/settings/" title={`${t.settings} | ${t.site}`} description={t.glIntro} noindex>
  <div class="prose">
    <h1>{t.settings}</h1>
    <h2 id="ui-language">{t.uiLang}</h2>
    <ul class="chips" aria-labelledby="ui-language">
      <li>
        <a class="chip" href={`${pageUrl('en', '/settings/')}?lang=en`} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a>
      </li>
      <li>
        <a class="chip" href={`${pageUrl('ru', '/settings/')}?lang=ru`} hreflang="ru" lang="ru" aria-current={lang === 'ru' ? 'true' : undefined}>Русский</a>
      </li>
    </ul>
    <h2>Grandlivre</h2>
    {message && <p class="note settings-note" role="status">{message}</p>}
    <p class="settings-status">
      {t.glStatus}: <strong>{status === 'connected' ? t.glConnected : status === 'reconnect' ? t.glReconnect : t.glNotConnected}</strong>
    </p>
    {
      !deps ? (
        <p>{t.glUnconfigured}</p>
      ) : status === 'connected' ? (
        <>
          <form method="post" action={`${base}/grandlivre/disconnect`}>
            <input type="hidden" name="lang" value={lang} />
            <button class="btn btn-secondary" type="submit">{t.glDisconnect}</button>
          </form>
          <p class="settings-hint">{t.glDisconnectHint}</p>
        </>
      ) : (
        <>
          <p>{t.glIntro}</p>
          <form method="post" action={`${base}/grandlivre/connect`}>
            <input type="hidden" name="lang" value={lang} />
            <button class="btn" type="submit">{status === 'reconnect' ? t.glReconnectBtn : t.glConnect}</button>
          </form>
          <p class="settings-hint">{t.glCookieHint}</p>
        </>
      )
    }
  </div>
</Layout>
