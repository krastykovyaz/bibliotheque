---
import Layout from '../layouts/Layout.astro';
import { ui, type UiLang } from '../lib/i18n';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<Layout lang={lang} path="/about/" title={`${t.aboutTitle} | ${t.site}`} description={t.aboutP1.slice(0, 150).replace(/\s+\S*$/, '') + '…'}>
  <div class="prose">
    <h1>{t.aboutTitle}</h1>
    <p>{t.aboutP1}</p>
    <p>{t.aboutP2}</p>
  </div>
</Layout>
